# Reverse proxy for the Xenia voice bridge.
# The body cap and the rate limit are REQUIRED, not optional: the app can only
# reject oversized requests that declare Content-Length, and it has no rate
# limiting of its own.

limit_req_zone $binary_remote_addr zone=xenia_voice:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name api.robleemedia.com;   # <-- your host

    ssl_certificate     /etc/letsencrypt/live/api.robleemedia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.robleemedia.com/privkey.pem;

    # Chunked requests carry no Content-Length; this is the only thing that
    # stops them.
    client_max_body_size 64k;

    location /v1/voice/ {
        limit_req zone=xenia_voice burst=5 nodelay;
        proxy_pass http://127.0.0.1:8137;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A voice tool call that takes this long has already failed the caller.
        proxy_read_timeout 15s;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8137/healthz;
    }

    location / { return 404; }
}

server {
    listen 80;
    server_name api.robleemedia.com;
    return 301 https://$host$request_uri;
}
